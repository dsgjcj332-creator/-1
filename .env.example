# ============================================================================
# ALA EL SAREE (عالسريع) - Environment Configuration
# Copy this file to .env and fill in your real values.
# ============================================================================

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5174
VITE_API_BASE_URL=http://localhost:3000

# JWT (generate a strong secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-a-strong-random-secret
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Supabase / PostgreSQL (Railway hosts the backend; Supabase hosts the DB)
# Get these from your Supabase project: Settings -> Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5174,http://localhost:5000,http://localhost:1000

# Cash on Delivery
COD_FEE_EGP=0
COD_COLLECTION_WINDOW_HOURS=48

# ============================================================================
# NOTE: Do not commit .env to git. Add it to .gitignore.
# ============================================================================
